{
  "name": "peitho-studio",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite build && unocss && concurrently -k -n build,uno,server -c blue,magenta,green \"vite build --watch\" \"unocss --watch\" \"tsx watch server.ts\"",
    "build": "vite build && unocss",
    "build:app": "bun run build && bun run scripts/stage-app.ts",
    "start": "tsx server.ts",
    "watch": "concurrently -k -n build,uno -c blue,magenta \"vite build --watch\" \"unocss --watch\"",
    "test": "bun test",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "icons": "bun run scripts/build-brand.ts"
  },
  "dependencies": {
    "@barefootjs/client": "^0.35.7",
    "@barefootjs/jsx": "^0.35.7",
    "@barefootjs/shared": "^0.35.7",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@replit/codemirror-vim": "^6.4.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2.7.3"
  },
  "devDependencies": {
    "@barefootjs/cli": "^0.35.7",
    "@barefootjs/test": "^0.35.7",
    "@barefootjs/vite": "^0.35.7",
    "@fontsource/charis-sil": "5.3.0",
    "@playwright/test": "^1.63.0",
    "@srsholmes/tauri-playwright": "^0.4.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.1.0",
    "@types/node": "^22.0.0",
    "@types/opentype.js": "^1.3.10",
    "@unocss/cli": "^66.0.0",
    "@unocss/preset-wind4": "^66.0.0",
    "concurrently": "^9.0.0",
    "fast-check": "^4.9.0",
    "opentype.js": "1.3.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "unocss": "^66.0.0",
    "vite": "^6.0.0"
  }
}
