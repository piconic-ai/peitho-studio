# vite build outputs (regenerated by `vite build`)
dist/

# Dependencies
node_modules/

# UnoCSS output (regenerated by `unocss --watch` / `unocss`)
public/uno.css

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Playwright MCP debug artifacts
.playwright-mcp/

# Personal/machine-local Claude Code settings — never shared project config
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Rust build output (src-tauri/.gitignore also covers this from within src-tauri)
src-tauri/target/
src-tauri/gen/schemas/
