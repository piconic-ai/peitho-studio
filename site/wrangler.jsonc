{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "peitho-studio-site",
  "compatibility_date": "2026-08-15",
  // No `main`: nothing runs on the Worker. `vite build` emits a fully static
  // page under `dist/`, and Cloudflare serves it as Workers Static Assets.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // The production hostname. `custom_domain` makes `wrangler deploy` create
  // the DNS record and certificate on the piconic.ai zone itself; nothing
  // to set up in the dashboard.
  "routes": [{ "pattern": "peitho-studio.piconic.ai", "custom_domain": true }],
  // No `*.workers.dev` copy of the production page. Per-version preview
  // URLs stay on: `wrangler deploy` syncs this flag to the dashboard, so
  // `false` here switched them off again on every production deploy.
  "workers_dev": false,
  "preview_urls": true
}
