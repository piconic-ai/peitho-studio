{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Peitho Studio",
  "version": "0.1.0-rc.6",
  "identifier": "ai.piconic.peitho-studio",
  "build": {
    "frontendDist": "../dist/app",
    "devUrl": "http://localhost:3003",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build:app"
  },
  "app": {
    "windows": [
      {
        "title": "Peitho Studio",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/crit"
    ],
    "resources": {
      "licenses/crit/LICENSE": "licenses/crit/LICENSE"
    },
    "category": "Productivity",
    "copyright": "Copyright (c) 2026 kfly8",
    "publisher": "kfly8",
    "shortDescription": "An editor for Peitho decks",
    "longDescription": "Peitho Studio is a desktop editor for Peitho, a Markdown-driven presentation engine: edit a deck's Markdown, see each slide rendered as you type, and present it.",
    "fileAssociations": [
      {
        "ext": [
          "md"
        ],
        "name": "Markdown",
        "role": "Editor",
        "contentTypes": [
          "net.daringfireball.markdown"
        ]
      }
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/piconic-ai/peitho-studio/releases/latest/download/latest.json"
      ]
    }
  }
}
